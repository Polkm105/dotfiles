# Copy this file to `.env` and fill in real values.
# `.env` is loaded into vim.env by lewis6991/env.nvim.

# CodeCompanion (lua/plugins/codecompanion.lua)
# Adapter name must match a config in lua/plugins/llm/ (by `name` or file name)
CC_LLM_ADAPTER=llama.cpp
# Model to use with the adapter (must exist on that endpoint)
CC_LLM_MODEL=Qwen-3.8-27B

# llama.cpp endpoint (lua/plugins/llm/llama-cpp.lua)
LLAMA_CPP_URL=localhost:8080
